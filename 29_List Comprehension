# List Comprehension = A concise to create lists in Python
#                      Compact and easier to read than traditional loops
#                      [expression for value in iterables if condition] ---> FORMULA

#Normal for loop
#      ^
#      |
#doubles = []
#for x in range(1, 11):
#    doubles.append(x * 2)
#print(doubles)

#List Comprehension
#      ^
#      |
doubles = [x * 2 for x in range(1, 11)] #---> have to use list's bracket
triples = [y * 3 for y in range(1, 11)]
squares = [z * z for z in range(1, 11)]
print(doubles)
print(triples)
print(squares)
