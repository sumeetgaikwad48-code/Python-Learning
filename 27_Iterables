#Iterables = An object/collection that can return its elements one at a time,
#            allowing it to be iterated over in a loop

#LIST

numbers = [1, 2, 3, 4, 5]
#We can reverse
for number in numbers:
    print(number, end = " ")
print()

#SET

fruits = {"apple", "orange", "banana", "coconut"}
#We can't reverse in set because they are unchangeable
for fruit in fruits:
    print(fruit)
print()

#STRINGS

name = "Mitsu  Gaming"

for character in name:
    print(character, end=" ")
print()

#Dictionary

my_dictionary = {"A" : 1,
                 "B" : 2,
                 "C" : 3}
for key, value in my_dictionary.items():
    print(f"{key} = {value}")
